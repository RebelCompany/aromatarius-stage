# Aromatarius.pl : variables d'environnement
# Copier en .env.local pour le developpement local.
# Toutes les cles peuvent rester vides : le site tourne alors en mode demo
# (catalogue local de 14 produits, panier en memoire, contenus MDX).
# Aucun secret ne doit etre commite dans ce fichier.

# --- Shopify : Storefront API -------------------------------------------
# Tant que STORE_DOMAIN ou les deux tokens sont vides, l'adapter bascule
# automatiquement en mode demo (voir src/lib/shopify/config.ts).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Version d'API, defaut 2026-07 si vide
SHOPIFY_API_VERSION=
# Domaine du checkout Shopify, ex. checkout.aromatarius.pl
SHOPIFY_CHECKOUT_DOMAIN=
# Secret partage du webhook products/update vers /api/revalidate
SHOPIFY_REVALIDATION_SECRET=
# Force le mode demo meme si les identifiants sont renseignes : 1 pour activer
SHOPIFY_MOCK=

# --- Boutique -----------------------------------------------------------
# Seuil de livraison gratuite en PLN, defaut 150 si vide
FREE_SHIPPING_THRESHOLD=

# --- SEO et analytics ---------------------------------------------------
# URL canonique. Si vide, l'URL de prod Vercel est utilisee, sinon localhost.
SITE_URL=
# 1 = blocage complet de l'indexation (a mettre sur les previews Vercel).
# RAPPEL LANCEMENT : retirer cette variable du projet Vercel de production.
SITE_NOINDEX=
# Conteneur Google Tag Manager, ex. GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- Scripts de migration (jamais necessaires au build) -----------------
# Token d'app custom Shopify, scopes write_products. Utilise par
# scripts/shopify-import.ts uniquement.
SHOPIFY_ADMIN_TOKEN=
# Source WooCommerce pour scripts/woo-export.ts, defaut https://aromatarius.pl
WOO_BASE_URL=

# --- Phase 2 : declarees dans CLAUDE.md, pas encore lues par le code ----
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# SHOPIFY_CUSTOMER_ACCOUNT_API_URL=
# JUDGEME_API_TOKEN=
# JUDGEME_SHOP_DOMAIN=
# SESSION_SECRET=

# Note : VERCEL_PROJECT_PRODUCTION_URL est injectee par Vercel, ne pas la definir.
